<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep the established non-www HTTPS origin.
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Canonicalize accidental nested document-root URLs.
    RewriteCond %{THE_REQUEST} "\s/+public(?:[/\s?])" [NC]
    RewriteRule ^public(?:/(.*))?$ /$1 [R=301,L,NE]

    # Do not expose repository-only material through Hostinger.
    RewriteRule ^(?:_archived|archive|project)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:README\.md|vercel\.json|\.vercelignore)$ - [F,L,NC]
    RewriteRule \.(?:md|csv)$ - [F,L,NC]

    # Hostinger serves the repository root; internally map public/ to the
    # existing canonical URLs without adding /public/ to browser addresses.
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^$ public/index.html [L]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.+)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
